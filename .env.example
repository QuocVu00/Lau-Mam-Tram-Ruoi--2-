# ==============================================================================
# TỆP MẪU BIẾN MÔI TRƯỜNG (.env.example)
# Hãy sao chép tệp này thành .env và điền các thông tin thực tế vào máy của bạn.
# ==============================================================================

# 1. KẾT NỐI CƠ SỞ DỮ LIỆU ĐÁM MÂY (SUPABASE POSTGRESQL)
# Dùng bộ gom kết nối (Pooler) cho ứng dụng
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Dùng kết nối trực tiếp cho Migration / npx prisma db push
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# 2. KHÓA BẢO MẬT PHIÊN LÀM VIỆC (SESSION TOKEN)
# Chuỗi bí mật dùng để ký và mã hóa cookie xác thực trong 20 ngày
SESSION_SECRET="thay_bang_chuoi_bi_mat_ngau_nhien_dai_it_nhat_32_ky_tu"

# 3. ĐĂNG NHẬP 1 CHẠM - GOOGLE OAUTH & GOOGLE ONE TAP
# Lấy từ Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# 4. ĐĂNG NHẬP 1 CHẠM - ZALO OAUTH
# Lấy từ Zalo Developers (developers.zalo.me)
ZALO_APP_ID="your_zalo_app_id_here"
ZALO_APP_SECRET="your_zalo_app_secret_here"

# 5. ĐĂNG NHẬP 1 CHẠM - FACEBOOK OAUTH
# Lấy từ Meta for Developers (developers.facebook.com)
FACEBOOK_APP_ID="your_facebook_app_id_here"
FACEBOOK_APP_SECRET="your_facebook_app_secret_here"

# 6. ĐƯỜNG DẪN GỐC CỦA ỨNG DỤNG (Dùng để định tuyến OAuth callback chuẩn xác)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

